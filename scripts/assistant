#!/usr/bin/env bash
# The pipeline's terminal assistant: Claude Code, started in the repository root,
# under the person's own account, with the assistant's own settings, instructions
# and skills from assistant/ (see assistant/README.md).
#
#     scripts/assistant                      start a session
#     scripts/assistant -c                   continue the last one
#     scripts/assistant --model claude-sonnet-5-5
#     scripts/assistant --print-command      show what would run, and run nothing
#
# What it sets up:
#   CRYOET_ASSISTANT        marks the session as the assistant's; submit_lanes.py
#                           and submit_recipe.py journal it and hold it to their gate
#   CRYOET_ASSISTANT_MODEL  the model it starts, for the journal; a full model ID
#                           (claude-opus-5-5 unless --model or the variable says)
#   --setting-sources user  the person's own settings, but not this clone's
#                           .claude/settings*.json, which belong to development
#   --settings              assistant/settings.json: the permission rules, and
#                           assistant/guard.py on every shell command
#   --plugin-dir            assistant/plugin: the skills
#   --append-system-prompt  assistant/instructions.md, in every turn
#   --strict-mcp-config     no MCP servers: none from the person's settings or
#                           plugins, and (ENABLE_CLAUDEAI_MCP_SERVERS=false) none
#                           of their claude.ai account's connectors. Each person
#                           has a different set, and none is the pipeline's
#   CLAUDE_CODE_AUTO_CONNECT_IDE=false
#                           no editor either (VS Code over SSH, say): its tools
#                           are not shell commands, so the guard never sees them
#   CRYOET_LIBRARY          the reference library (docs/library.md): the folder
#                           that holds its snapshots, or "none" for a session
#                           without it. Unset, a session for a person takes the
#                           first site folder in LIBRARY_SITES that exists, and a
#                           headless run (-p) takes none, so that an evaluation
#                           reads the library only when it says so. The snapshot
#                           `current` names at the start is the one the session
#                           reads, by its own name: --add-dir lets the session
#                           read it, assistant/library.md and its path join the
#                           instructions, and CRYOET_LIBRARY_ROOT and
#                           CRYOET_LIBRARY_SNAPSHOT tell assistant/guard.py what
#                           is never to be written
#
# Other options pass on to claude, except the ones that would undo the above.
# --permission-mode acceptEdits passes only with -p, for a headless run such as
# scripts/run_cases.py's evaluation, where nobody is there to approve an edit:
# it stands in for the person who would. In the working directory it lets edits
# through, and mkdir, touch, cp, mv, rm, rmdir and sed too. Every deny and ask
# rule still holds, and anything else that would ask is refused, since a -p run
# has nobody to ask. A session started for a person asks before each edit, as
# before.
# Switching the model inside a session (/model) leaves CRYOET_ASSISTANT_MODEL
# naming the first one: start a new session instead.
#
# Disposable, like the rest of scripts/: the first increment of the assistant
# (docs/agent_architecture.md).

set -euo pipefail

REPO=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
model=${CRYOET_ASSISTANT_MODEL:-claude-opus-5-5}
print_only=0
accept_edits=0
passed=()
while (($#)); do
    case "$1" in
        --model)
            model=${2:?--model needs a model ID}
            shift 2
            ;;
        --model=*)
            model=${1#--model=}
            shift
            ;;
        --print-command)
            print_only=1
            shift
            ;;
        -h | --help)
            sed -n '2,/^$/s/^# \{0,1\}//p' "${BASH_SOURCE[0]}"
            exit 0
            ;;
        --permission-mode=acceptEdits)
            accept_edits=1
            shift
            ;;
        --permission-mode)
            if [[ "${2:-}" != acceptEdits ]]; then
                echo "scripts/assistant: --permission-mode ${2:-} would undo what the" \
                    "assistant is started with (see the header of scripts/assistant)" >&2
                exit 2
            fi
            accept_edits=1
            shift 2
            ;;
        --dangerously-skip-permissions | --allow-dangerously-skip-permissions | \
        --permission-mode | --permission-mode=* | --settings | --settings=* | \
        --setting-sources | --setting-sources=* | --allowedTools | --allowedTools=* | \
        --allowed-tools | --allowed-tools=* | --tools | --tools=* | \
        --system-prompt | --system-prompt=* | --system-prompt-file | --system-prompt-file=* | \
        --plugin-dir | --plugin-dir=* | --plugin-url | --plugin-url=* | --safe-mode | --bare | \
        --mcp-config | --mcp-config=* | --ide)
            echo "scripts/assistant: ${1%%=*} would undo what the assistant is started with" \
                "(see the header of scripts/assistant); run claude itself for that" >&2
            exit 2
            ;;
        *)
            passed+=("$1")
            shift
            ;;
    esac
done

# The journal names the model by what is given here, and an alias names a
# different model as releases move on.
case "$model" in
    opus | sonnet | haiku | fable | default | best | opusplan)
        echo "scripts/assistant: give a full model ID, such as claude-opus-5-5, not the" \
            "alias '$model', so that the journal says which model it was" >&2
        exit 2
        ;;
esac

claude=$(command -v claude || true)
if [[ -z "$claude" ]]; then
    echo "scripts/assistant: Claude Code (claude) is not on PATH. Install it, or ask" \
        "whoever set up the assistant on this machine." >&2
    exit 1
fi
version=$("$claude" --version 2>/dev/null | head -n 1 || true)
export CRYOET_ASSISTANT="cryoet-assistant; claude-code ${version%% *}"
export CRYOET_ASSISTANT_MODEL=$model
export ENABLE_CLAUDEAI_MCP_SERVERS=false
export CLAUDE_CODE_AUTO_CONNECT_IDE=false

cd "$REPO"
options=(
    --model "$model"
    --setting-sources user
    --settings "$REPO/assistant/settings.json"
    --plugin-dir "$REPO/assistant/plugin"
    --strict-mcp-config
)
headless=0
for arg in ${passed[@]+"${passed[@]}"}; do
    if [[ "$arg" == -p || "$arg" == --print ]]; then headless=1; fi
done

# The reference library's folders on the sites; assistant/guard.py guards the
# same ones.
LIBRARY_SITES=(/fast/AG_Kudryashev/cryoet-library)
unset CRYOET_LIBRARY_ROOT CRYOET_LIBRARY_SNAPSHOT
library=${CRYOET_LIBRARY-}
if [[ -z "$library" ]] && ((!headless)); then
    for site in "${LIBRARY_SITES[@]}"; do
        if [[ -d "$site" ]]; then
            library=$site
            break
        fi
    done
fi
snapshot=
if [[ -n "$library" && "$library" != none ]]; then
    if [[ -f "$library/current/library.json" ]]; then
        snapshot=$(cd "$library/current" && pwd -P)
        root=$(cd "$library" && pwd -P)
        export CRYOET_LIBRARY_ROOT=$root CRYOET_LIBRARY_SNAPSHOT=$snapshot
        options+=(--add-dir "$snapshot")
    else
        echo "scripts/assistant: no library snapshot at $library/current; the session" \
            "starts without the library" >&2
    fi
fi
prompt=$(cat "$REPO/assistant/instructions.md")
if [[ -n "$snapshot" ]]; then
    prompt+=$'\n\n'"$(cat "$REPO/assistant/library.md")"
    prompt+=$'\n\n'"This session's library is $snapshot (snapshot ${snapshot##*/})."
fi

if ((accept_edits)); then
    if ((!headless)); then
        echo "scripts/assistant: --permission-mode acceptEdits is for a headless run (-p)," \
            "where nobody can approve an edit; a session asks the person instead" >&2
        exit 2
    fi
    options+=(--permission-mode acceptEdits)
fi
if ((print_only)); then
    printf 'CRYOET_ASSISTANT=%q\nCRYOET_ASSISTANT_MODEL=%q\n' \
        "$CRYOET_ASSISTANT" "$CRYOET_ASSISTANT_MODEL"
    printf 'ENABLE_CLAUDEAI_MCP_SERVERS=false\nCLAUDE_CODE_AUTO_CONNECT_IDE=false\n'
    if [[ -n "$snapshot" ]]; then
        printf 'CRYOET_LIBRARY_ROOT=%q\nCRYOET_LIBRARY_SNAPSHOT=%q\n' "$root" "$snapshot"
    fi
    printf 'cd %q\n' "$REPO"
    printf '%q' "$claude"
    printf ' %q' "${options[@]}"
    if [[ -n "$snapshot" ]]; then
        printf ' --append-system-prompt "$(cat assistant/instructions.md assistant/library.md)'
        printf ' and the library'\''s path"'
    else
        printf ' --append-system-prompt "$(cat assistant/instructions.md)"'
    fi
    printf ' --name cryoet-assistant'
    # printf repeats its format at least once, so with nothing passed on it
    # would print an empty argument.
    if ((${#passed[@]})); then printf ' %q' "${passed[@]}"; fi
    printf '\n'
    exit 0
fi
if [[ -n "$snapshot" ]]; then
    echo "scripts/assistant: library snapshot ${snapshot##*/}, read-only" >&2
fi
exec "$claude" "${options[@]}" \
    --append-system-prompt "$prompt" \
    --name cryoet-assistant ${passed[@]+"${passed[@]}"}
