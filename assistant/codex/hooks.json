{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CRYOET_ASSISTANT_REPO/assistant/guard.py\""
          }
        ]
      },
      {
        "matcher": "apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CRYOET_ASSISTANT_REPO/assistant/guard.py\""
          }
        ]
      }
    ]
  }
}
